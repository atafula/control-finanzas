rules_version = '2';
// Reglas para Mis Gastos. Cópialas en Firebase → Firestore → Reglas → Publicar.
// Son las mismas comprobaciones que validGasto() y validFijo() en utils.js.
// NUEVO en el rediseño: los campos tipo, extra y fijo en los gastos, y fijos en users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validGasto(d) {
      return d.keys().hasOnly(['concepto', 'importe', 'categoria', 'fecha', 'ts', 'importado', 'tipo', 'extra', 'fijo'])
        && d.importe is number && d.importe > 0 && d.importe < 1000000
        && d.categoria is string && d.categoria.size() > 0 && d.categoria.size() <= 60
        && d.fecha is string && d.fecha.size() <= 30 && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}.*')
        && (!('concepto' in d) || (d.concepto is string && d.concepto.size() <= 200))
        && (!('ts' in d) || d.ts is number)
        && (!('importado' in d) || d.importado is bool)
        && (!('tipo' in d) || d.tipo in ['gasto', 'ingreso'])
        && (!('extra' in d) || d.extra is bool)
        && (!('fijo' in d) || (d.fijo is string && d.fijo.size() > 0 && d.fijo.size() <= 60));
    }

    function validUser(d) {
      return d.keys().hasOnly(['cats', 'catsText', 'fijos'])
        && (!('cats' in d) || (d.cats is list && d.cats.size() <= 100))
        && (!('catsText' in d) || (d.catsText is string && d.catsText.size() <= 10000))
        && (!('fijos' in d) || (d.fijos is list && d.fijos.size() <= 100));
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validUser(request.resource.data);
      allow delete: if owner(uid);

      match /gastos/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validGasto(request.resource.data);
      }
    }
  }
}
